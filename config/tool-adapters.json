    {"capability": "rendering", "candidate": "ffmpeg or installed editor API", "status": "must-detect"},
    {"capability": "visual_review", "candidate": "frame extraction and vision-capable tool", "status": "must-detect"},
    {"capability": "audio_review", "candidate": "audio playback/transcription/analysis tool", "status": "must-detect"},
    {"capability": "asset_research", "candidate": "authorized search/browser/asset API", "status": "must-detect"},
    {"capability": "specialist_skills", "candidate": "host-provided skill discovery", "status": "must-detect"}
  ]
}

{
  "note": "This is a template. Runtime discovery must verify every capability before use.",
  "discovery_policy": {
    "detect_os_runtime_and_resources": true,
    "discover_installed_skills_and_agents": true,
    "discover_editors_cli_tools_and_apis": true,
    "verify_capabilities_before_execution": true,
    "never_assume_credentials_or_network_access": true,
    "never_install_or_spend_without_authorization": true
  },
  "adapter_examples": [
